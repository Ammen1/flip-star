# =============================================================================
# FlipStar backend — environment template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit a populated .env.
#
#   cp .env.example .env
#
# Production refuses to start when a required value is missing or is left at an
# insecure default — see config/settings/production.py.
# =============================================================================


# --- Environment selection ---------------------------------------------------
# Which settings module to load. One of: development | testing | production
# Docker sets DJANGO_SETTINGS_MODULE directly; this is the fallback used when
# something imports the legacy `config.settings` path.
DJANGO_ENV=development
# DJANGO_SETTINGS_MODULE=config.settings.production


# --- HashiCorp Vault ---------------------------------------------------------
# Optional. With VAULT_ADDR empty, everything below resolves from this file and
# the OS environment exactly as before. Full guide: docs/secrets.md
#
# Resolution order: OS environment -> Vault -> this file -> built-in default.
# NOTE: a value set in the environment SHADOWS Vault. After populating Vault,
# delete the x-secret-env block from docker-compose.yml or Vault is never read.

VAULT_ADDR=
# Production: AppRole. Never ship a root token.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Development only (matches the `vault` compose profile's dev-mode root token).
VAULT_TOKEN=

VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=flipstar/backend
VAULT_NAMESPACE=

# true = a Vault outage stops the container instead of silently falling back.
# Set this in production once Vault is the source of truth.
VAULT_REQUIRED=false

# 'env' (default) or 'vault' — which wins when a key exists in both.
VAULT_PRECEDENCE=env

# TLS. VAULT_SKIP_VERIFY must never be true in production.
VAULT_CACERT=
VAULT_SKIP_VERIFY=
VAULT_TIMEOUT=5

# Root token for the dev-mode Vault container (`--profile vault`). Dev only.
VAULT_DEV_ROOT_TOKEN_ID=flipstar-dev-root


# =============================================================================
# Everything below this line is a candidate for Vault.
# Migrate with:  python manage.py vault_push --env-file .env --confirm
# =============================================================================


# --- Core --------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-50-character-random-string

DEBUG=True

# Comma-separated. Must include every hostname the service is reached by.
ALLOWED_HOSTS=localhost,127.0.0.1

# Absolute base used when building media URLs in API responses.
BACKEND_URL=http://localhost:8000

LOG_LEVEL=INFO


# --- Database ----------------------------------------------------------------
# Force the local/Docker PostgreSQL and ignore any managed-platform variables
# that may be left over from a previous deployment.
USE_DOCKER_DB=true

DB_ENGINE=django.db.backends.postgresql
DB_NAME=flipstar_db
DB_USER=flipstar_user
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer

# Seconds to keep a connection open. 0 opens a new connection per request.
DB_CONN_MAX_AGE=60


# --- Redis -------------------------------------------------------------------
# Backs the Django cache (OTP codes, throttle counters), the Channels layer and
# the Celery broker. Databases: /0 Celery, /1 cache.
REDIS_HOST=redis
REDIS_PORT=6379


# --- Object storage (S3 / MinIO) --------------------------------------------
# Media falls back to the local filesystem when these are unset, which does NOT
# survive a container restart. Set them for any real deployment.
# Legacy AWS_-prefixed names are also accepted.
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
REGION_NAME=us-east-1

# Set for self-hosted MinIO; leave blank for AWS S3.
S3_ENDPOINT_URL=
S3_USE_SSL=false


# --- CORS --------------------------------------------------------------------
# Production refuses to start with CORS_ALLOW_ALL_ORIGINS=true.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000


# --- Transport security (production only) ------------------------------------
# Disable the redirect only if the container is reached over plain HTTP without
# an X-Forwarded-Proto header; otherwise it causes a redirect loop.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000


# --- Web Push (VAPID) --------------------------------------------------------
# Generate once with: python -m py_vapid --gen --applicationServerKey
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# --- Telebirr: Direct Debit (SOAP) -------------------------------------------
# Issued by Ethio Telecom. Never commit real values.
TELEBIRR_SOAP_URL=
TELEBIRR_THIRD_PARTY_ID=
TELEBIRR_THIRD_PARTY_PASSWORD=
TELEBIRR_SHORTCODE=
TELEBIRR_RESULT_URL=
TELEBIRR_PAYEE_ACCOUNT_NAME=Flipstar
TELEBIRR_CALLER_TYPE=2

TELEBIRR_SP_OPERATOR_ID=
TELEBIRR_SP_OPERATOR_CREDENTIAL=
TELEBIRR_ORG_OPERATOR_ID=
TELEBIRR_ORG_OPERATOR_CREDENTIAL=


# --- Telebirr: Checkout (REST) -----------------------------------------------
TELEBIRR_BASE_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_NOTIFY_URL=
TELEBIRR_RETURN_URL=

# PEM keys. Prefer mounting these as files or injecting from a secret manager
# rather than putting multi-line values in .env.
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=


# --- SMS ---------------------------------------------------------------------
# Every SMS, OTPs included, goes over TIMWE SMPP. OneVAS has been removed.
# The TIMWE_SMPP_* credentials belong in Vault, not here -- see docs/sms-smpp.md.
SMS_PROVIDER=timwe_smpp
SMS_SHORT_CODE=9286


# --- Email -------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com


# --- Bootstrap admin ---------------------------------------------------------
# Consumed by `python manage.py create_superadmin`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=


# --- Auth ---------------------------------------------------------------------
# Days an auth token stays valid after creation. 0 disables expiry.
AUTH_TOKEN_TTL_DAYS=14

# IPs/CIDR ranges of reverse proxies this deployment controls. Only requests
# whose direct peer is in this list have X-Forwarded-For trusted for
# rate-limit/audit-log purposes. Default is correct when nginx runs on the
# same host/Docker network as the backend.
TRUSTED_PROXY_IPS=127.0.0.1,::1


# --- Push (FCM) --------------------------------------------------------------
FIREBASE_SERVER_KEY=


# --- Local development conveniences ------------------------------------------
# Use an in-process cache and channel layer so the API boots without Redis.
# Never enable outside local development: OTP state stops being shared between
# processes.
USE_LOCMEM_CACHE=false

# =============================================================================
# Additional Telebirr and Ethio Telecom CRM variables
# =============================================================================
# These keys were previously present in this file WITH REAL PRODUCTION VALUES,
# pasted in below the template. The values (including a live Telebirr RSA
# private key, a live VAPID EC private key, the admin password, the Django
# SECRET_KEY, the database password and the Onevas application key) have been
# removed -- they are documented in k8s/README.md under "ROTATION REQUIRED".
# The key names are kept so this file stays a complete reference.
#
# Leave every value blank here. Real values belong in Vault
# (flipstar/backend/<environment>), never in this file.

# --- Telebirr: Checkout / H5 -------------------------------------------------
TELEBIRR_H5_BASE_URL=
TELEBIRR_REDIRECT_URL=
TELEBIRR_DISBURSE_NOTIFY_URL=
TELEBIRR_VERIFY_SSL=true

# --- Telebirr: mandate templates ---------------------------------------------
TELEBIRR_MANDATE_TEMPLATE_DAILY=
TELEBIRR_MANDATE_TEMPLATE_WEEKLY=
TELEBIRR_MANDATE_TEMPLATE_MONTHLY=

# --- Telebirr: B2C payout ----------------------------------------------------
TELEBIRR_B2C_SERVICE_CODE=
TELEBIRR_B2C_REASON_TYPE=
TELEBIRR_B2C_RESULT_URL=
TELEBIRR_B2C_SOAP_URL=
TELEBIRR_B2C_ORG_OPERATOR_ID=
TELEBIRR_B2C_ORG_OPERATOR_CREDENTIAL=
TELEBIRR_B2C_THIRD_PARTY_ID=
TELEBIRR_B2C_THIRD_PARTY_PASSWORD=

# --- Telebirr: USSD push -----------------------------------------------------
TELEBIRR_USSD_MERCHANT_SHORTCODE=
TELEBIRR_USSD_RESULT_URL=
TELEBIRR_USSD_SOAP_URL=
TELEBIRR_USSD_THIRD_PARTY_ID=
TELEBIRR_USSD_THIRD_PARTY_PASSWORD=
TELEBIRR_USSD_ORG_OPERATOR_ID=
TELEBIRR_USSD_ORG_OPERATOR_CREDENTIAL=

# --- Ethio Telecom CRM (PresentServiceGift API) ------------------------------
CRM_ENDPOINT=
CRM_SERVICE_NUMBER_A=
CRM_ACCESS_USER=
CRM_ACCESS_PASSWORD=
CRM_CHANNEL_ID=
CRM_TECHNICAL_CHANNEL_ID=
CRM_TENANT_ID=
CRM_CURRENCY_ID=
CRM_CHARGE_CODE=
CRM_OFFERING_ID=
CRM_CHARGE_AMOUNT=
