# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
# IMPORTANT: include the server's public IP and any domain you serve from.
# Example for Ethio Telecom server: 196.189.236.140,your-domain.com,localhost
ALLOWED_HOSTS=196.189.236.140,your-domain.com,localhost,127.0.0.1


# Database Configuration
# Force use of the local Docker postgres service. Leave this TRUE for the
# Ethio Telecom server so stray RENDER / DATABASE_URL env vars can't silently
# redirect the app to an old Neon database.
USE_DOCKER_DB=true
DB_NAME=flipstar_db
DB_USER=flipstar_user
DB_PASSWORD=your-db-password-here
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost

# Cloudinary (optional - will be removed after S3 migration)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
