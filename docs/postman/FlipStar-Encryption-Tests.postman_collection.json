          "name": "3.7 Tampered checksum → 400 (integrity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 400, not 409', () => {",
                  "    // 409 here would mean the nonce was already used and the replay check",
                  "    // fired first — re-run 3.6 to mint a fresh envelope.",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('reported as a decryption failure', () => {",
                  "    pm.expect(pm.response.json().code).to.eql('decryption_failed');",
                  "});",
                  "",
                  "// Decryption and authentication both succeeded — the ciphertext is",
                  "// genuine. The checksum is computed over",
                  "//   json.dumps(data, separators=(',', ':'), sort_keys=True)",
                  "// so a client that serialises differently fails here even with correct",
                  "// keys, which is the single most common integration bug."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Client-Public-Key", "value": "{{clientPublicKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"encrypted\": \"{{freshEncrypted}}\",\n  \"nonce\": \"{{freshNonce}}\",\n  \"checksum\": \"{{badChecksum}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
