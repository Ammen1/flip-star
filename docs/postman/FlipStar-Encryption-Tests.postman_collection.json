            "body": {
              "mode": "raw",
              "raw": "{\n  \"encrypted\": \"{{badEncrypted}}\",\n  \"nonce\": \"{{freshNonce}}\",\n  \"checksum\": \"{{freshChecksum}}\"\n}",
