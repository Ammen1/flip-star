                  "const descMatch = raw.match(/<ns1:resultDescription>([^<]*)<\\/ns1:resultDescription>/);",
                  "const code = codeMatch ? codeMatch[1] : null;",
                  "const desc = descMatch ? descMatch[1] : \"\";",
                  "",
                  "pm.test(\"HTTP 200 with a SOAP body\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");",
                  "    pm.expect(code, \"no <ns1:result> element in the response\").to.not.be.null;",
                  "});",
                  "",
                  "console.log(\"result \" + code + \" - \" + desc);",
                  "",
                  "pm.test(\"2032 for an unmapped product\", function () {",
