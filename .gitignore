# =============================================================================
# Backend
# =============================================================================
# NOTE: .env files were tracked in this repository's history and every secret
# they contained must be treated as compromised. See the restructure report.

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/staticfiles/**/*.key
render.env
# Leading slash matters: an unanchored `secrets/` matches a directory of
# that name at ANY depth, which silently excluded infrastructure/secrets/ --
# the Vault client and secret-resolution provider imported by every settings
# module. The repository was pushed without it and nothing that loads Django
# settings could run. This anchors the rule to a top-level secrets/ only.
# (Note: .dockerignore's identical-looking `secrets/` is already root-anchored
# -- Docker's ignore patterns do not match at arbitrary depth the way git's do.)
/secrets/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/
env/

# --- Django ------------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal
fallback_db.sqlite3
local_settings.py

# Collected static output is a build artifact, not source.
staticfiles/

# User-uploaded content must never be committed.
media/

# Database dumps
*.sql
*.dump
flipstar_db
neondb

# --- Testing / tooling -------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Editors / OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
